# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Build / packaging
build/
dist/
*.egg-info/
.eggs/
*.whl

# ---------------------------------------------------------------------------
# Virtual environments (uv manages .venv/)
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Data — never commit raw, interim or processed data.
# Paths are anchored to the repo root so src/data/ is NOT ignored.
# ---------------------------------------------------------------------------
/data/raw/*
!/data/raw/.gitkeep
/data/interim/*
!/data/interim/.gitkeep
/data/processed/*
!/data/processed/.gitkeep

# Generated tabular/model artifacts
*.parquet
*.feather
*.arrow
*.h5
*.hdf5
# The one tracked data artifact: the shared fold assignment file.
!/splits/folds.parquet

# Model and tuning artifacts
*.pkl
*.pickle
*.joblib
*.cbm
*.model
*.pt
*.pth
*.ckpt
*.onnx
*.db
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# Experiment tracking and reports generated by runs
# ---------------------------------------------------------------------------
/mlruns/
/mlartifacts/
/reports/runs/
/logs/
*.log

# ---------------------------------------------------------------------------
# Test, lint and type-check caches
# ---------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
coverage.json

# ---------------------------------------------------------------------------
# Notebooks
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
*.nbconvert.ipynb
*.nbconvert.html
*.nbconvert.py

# ---------------------------------------------------------------------------
# Secrets and local environment
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
kaggle.json
.kaggle/

# ---------------------------------------------------------------------------
# Editors, OS, temp files
# ---------------------------------------------------------------------------
.idea/
.vscode/
.fleet/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
tmp/
.tmp/
